# ============================================================
# GACI Backend — Variables de Entorno
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas .env a Git.
# ============================================================

# Base de datos
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gaci_db"

# JWT — genera secrets largos y aleatorios (mínimo 64 caracteres)
# Ejemplo: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="reemplaza-con-secret-aleatorio-muy-largo"
JWT_REFRESH_SECRET="reemplaza-con-otro-secret-diferente-muy-largo"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Servidor
PORT=3000
NODE_ENV="development"

# CORS — URL del frontend
CORS_ORIGIN="http://localhost:5173"

# Seed — contraseña inicial del admin (solo para primer deploy)
# Se debe cambiar inmediatamente después del primer login
ADMIN_INITIAL_PASSWORD="ChangeMe.2026!"
